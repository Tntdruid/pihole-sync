# Copy to sync.env and fill in.
# Format: URL|password. Use an app password (Settings -> Web interface / API ->
# Configure app password) so it also works with 2FA. "file:/path" reads the password
# from a file. Leave out "|password" if the Pi-hole has no password.
#
# Without a password, Pi-hole only answers to its own names (IP address, pi.hole,
# webserver.domain or hostname). If you get "HTTP 401", use the IP address.

PRIMARY=https://192.168.1.2|APP_PASSWORD_1
# Separate multiple replicas with commas
REPLICAS=https://192.168.1.3|APP_PASSWORD_2,https://192.168.1.4|APP_PASSWORD_3

# How often to sync (seconds). 0 = run once and exit (for cron).
INTERVAL=300

# What to sync: lists, domains, clients, config, blocking
# Groups are always included. "blocking" makes the replicas follow the primary when
# blocking is turned off/on (e.g. "disable for 5 minutes").
SYNC=lists,domains,clients,config

# Which settings to sync under "config". Empty = the default list
# (upstreams, local DNS records, CNAMEs, conditional forwarding, DNSSEC and more).
# +key adds, -key removes, a list without +/- replaces the default entirely. Example:
# CONFIG_KEYS=+misc.dnsmasq_lines,-dns.rateLimit
CONFIG_KEYS=

# 1 = require a valid certificate. Set to 0 if your Pi-holes use self-signed certificates.
VERIFY_TLS=1

# Only show what would change
DRY_RUN=0

# Optional: ping e.g. healthchecks.io after every run (+ /fail on errors)
HEALTHCHECK_URL=

LOG_LEVEL=INFO
